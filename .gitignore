# Root-level ignores for the NewsWireHub monorepo (backend + frontend + infra)

# Backend (Maven / Java)
backend/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Frontend (Angular / Node)
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl

# CI/CD run artifacts
ci-cd/*.txt
!ci-cd/setup.txt

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
